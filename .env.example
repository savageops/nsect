# --- Deployment mode (load-bearing) ---
# Local mode (default): the engine runs keyless, unqueued, and ungated.
# Hosted mode: API keys, rate limiting, and the 6s search cooldown activate.
# NODE_ENV=production ALSO implies hosted mode (safety: prod cannot run keyless).
NSECT_HOSTED=

# --- Admin secret (hosted mode only; required when hosted) ---
# Must be a strong secret. The server fail-fasts at startup if hosted mode
# has no ADMIN_KEY. Ignored in local mode.
ADMIN_KEY=

# --- HTTP listen port ---
PORT=3000

# --- Key-state DB path ---
# JS runtime uses this path for the SQLite key store (hosted mode only).
NSECT_DB_PATH=data/keys.sqlite
# Rust runtime override.
NSECT_RS_DB_PATH=rust/data/keys.sqlite

# --- MCP client config (for agent integration) ---
NSECT_API_URL=http://localhost:3000
# Optional in local mode; required when the target server runs hosted.
NSECT_API_KEY=

# --- Transcript adapter tuning (optional) ---
NSECT_INVIDIOUS_INSTANCES=
NSECT_PIPED_INSTANCES=
NSECT_YTDLP_COMMANDS=

# --- Challenge solver (optional; enables interactive challenge solving) ---
# When set, nsect solves Cloudflare Turnstile / hCaptcha / reCAPTCHA challenges
# via the configured provider instead of failing with CHALLENGE_BLOCKED.
# Provider: capsolver (default, recommended) | twocaptcha | anticaptcha
NSECT_SOLVER_PROVIDER=capsolver
NSECT_SOLVER_API_KEY=
NSECT_SOLVER_TIMEOUT=60
NSECT_SOLVER_KINDS=cloudflare_turnstile,cloudflare,hcaptcha,recaptcha

# --- Browser binary (optional) ---
# Set to 1 to force the bundled Chromium instead of a real Chrome install
# (real Chrome has a better TLS fingerprint; bundled is more portable).
NSECT_USE_BUNDLED_CHROME=

# --- Proxy with auth (optional; for residential proxies) ---
# BrightData/Smartproxy/Oxylabs use authenticated gateways. Pass the host here
# and the credentials separately (the --proxy-server flag can't carry auth).
# Or embed credentials in NSECT_PROXY as http://user:pass@host:port.
# NSECT_PROXY=http://brd.superproxy.io:22225
# NSECT_PROXY_USER=brd-customer-xxxx-zone-residential
# NSECT_PROXY_PASS=password
