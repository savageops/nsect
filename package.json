{
  "name": "@nsect/cli",
  "version": "1.0.0",
  "description": "Programmable web retrieval for AI products — stealth browser engine, multi-engine search, YouTube transcripts, challenge bypass, and DOM-scored extraction. CLI, HTTP API, and MCP server.",
  "type": "module",
  "main": "nsect-engine.js",
  "bin": {
    "nsect": "nsect-engine.js"
  },
  "files": [
    "nsect-engine.js",
    "api.js",
    "server/",
    "packages/mcp/index.js",
    "packages/mcp/api-client.js",
    "packages/mcp/package.json",
    "scripts/save-transcript.mjs",
    "scripts/harvest-search.mjs",
    "vitest.config.js"
  ],
  "keywords": [
    "web-scraping",
    "crawler",
    "scraper",
    "headless-browser",
    "puppeteer",
    "stealth",
    "anti-bot",
    "cloudflare-bypass",
    "serp",
    "search",
    "youtube-transcript",
    "mcp",
    "llm",
    "rag",
    "content-extraction",
    "markdown"
  ],
  "author": "Savage <savagejayog@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/savageops/nsect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savageops/nsect.git"
  },
  "bugs": {
    "url": "https://github.com/savageops/nsect/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "engine": "node nsect-engine.js",
    "server": "node api.js",
    "mcp": "node packages/mcp/index.js",
    "transcript:save": "node scripts/save-transcript.mjs",
    "research:harvest": "node scripts/harvest-search.mjs",
    "install-browser": "node node_modules/puppeteer/install.mjs",
    "install-mcp": "cd packages/mcp && npm install",
    "install-all": "npm install && cd packages/mcp && npm install",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/fingerprint.test.js tests/formatters.test.js tests/keys.test.js tests/auth-middleware.test.js tests/observability-metrics.test.js",
    "test:routes": "vitest run tests/routes.test.js",
    "test:cli": "vitest run tests/cli.test.js",
    "test:integration": "vitest run tests/engine-integration.test.js",
    "test:mcp": "vitest run tests/mcp-api-client.test.js tests/mcp-stdio.test.js",
    "test:live": "cross-env LIVE_INTEGRATION=1 vitest run tests/cli.test.js tests/routes.test.js tests/engine-integration.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "defuddle": "^0.19.2",
    "express": "^5.2.1",
    "linkedom": "^0.18.13",
    "puppeteer": "^24.4.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "rebrowser-puppeteer-core": "^24.8.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.2"
  }
}
